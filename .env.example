# Токен бота от @BotFather. Обязателен: без него процесс упадёт при запуске.
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Окружение: development или production. Передаётся в Sentry как имя окружения.
NODE_ENV=development

# Фиксированный канал (необязательно)
# Если задан, канал одинаков для всех пользователей, а команды /setchannel
# и /removechannel не регистрируются.
# Формат: числовой ID (например, -1001234567890) или @username канала.
# Узнать ID можно через /info после настройки канала вручную либо через любой
# бот-определитель ID; у публичного канала достаточно @username.
# Применяется только к сессиям, созданным ПОСЛЕ установки переменной.
FIXED_CHANNEL_ID=

# Владелец бота (необязательно)
# Числовой Telegram ID. Включает команду /dump_db, которая отправляет владельцу
# весь файл базы channels.db - вместе с настройками всех каналов и сессиями
# пользователей. Не задавайте, если такая выгрузка не нужна.
BOT_OWNER_ID=

# Sentry (необязательно)
# DSN вида https://<key>@<org>.ingest.sentry.io/<project>.
# Если пусто, отправка ошибок в Sentry отключена.
SENTRY_DSN=

# PostHog (необязательно)
# Ключ проекта вида phc_... . Если пусто, продуктовая аналитика полностью отключена.
# Что именно отправляется - см. раздел "Телеметрия" в README.md.
POSTHOG_API_KEY=

# Хост PostHog (необязательно)
# По умолчанию https://eu.i.posthog.com. Регион обязан совпадать с регионом проекта:
# ключ из US-облака не примут на EU-хосте и наоборот. Для self-hosted укажите свой адрес.
POSTHOG_HOST=

# Соль для идентификаторов аналитики (обязательна, если задан POSTHOG_API_KEY)
# Длинная случайная строка, например `openssl rand -hex 32`. Telegram ID пользователей
# уходят в PostHog только как HMAC-SHA256 с этой солью - в открытом виде они не
# отправляются никогда.
# Значения по умолчанию нет: если задан POSTHOG_API_KEY, а соль не задана, бот
# откажется запускаться. Так задумано - хеш без явно выбранной соли можно подобрать
# перебором, и молча собирать такие данные хуже, чем не собирать их вовсе.
# Соль нужно сохранить: при её смене все пользователи в статистике станут "новыми".
POSTHOG_ID_SALT=
