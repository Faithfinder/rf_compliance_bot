# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Environment
NODE_ENV=development

# Fixed Channel Mode (optional)
# When set, all users will automatically use this channel
# and /setchannel command will be unavailable
# Format: channel ID (e.g., -1001234567890) or username (e.g., @channelname)
FIXED_CHANNEL_ID=

# Bot Owner (optional)
# Numeric Telegram user ID of the bot owner. Enables /dump_db, which sends the entire
# channels.db SQLite file over Telegram - leave unset unless you need that.
BOT_OWNER_ID=

# Sentry Configuration (optional)
SENTRY_DSN=
